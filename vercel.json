{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://3.110.222.33/api/$1"
    },
    {
      "src": "/parent(.*)",
      "dest": "http://3.110.222.33/parent$1"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "http://3.110.222.33/dashboard$1"
    },
    {
      "src": "/wheel(.*)",
      "dest": "/public/wheel.html"
    },
    {
      "src": "/genesis(.*)",
      "dest": "/public/genesis/index.html"
    },
    {
      "src": "/login(.*)",
      "dest": "/public/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' http://3.110.222.33 https://www.google-analytics.com https://checkout.razorpay.com https://api.render.com; frame-src 'self' https://www.youtube.com https://checkout.razorpay.com; object-src 'none';"
        }
      ]
    }
  ]
}
