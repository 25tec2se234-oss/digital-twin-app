{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://digital-twin-verse-app.onrender.com/api/$1"
    },
    {
      "src": "/parent(.*)",
      "dest": "https://digital-twin-verse-app.onrender.com/parent$1"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "https://digital-twin-verse-app.onrender.com/dashboard$1"
    },
    {
      "src": "/wheel(.*)",
      "dest": "/public/wheel.html"
    },
    {
      "src": "/genesis(.*)",
      "dest": "/public/genesis/index.html"
    },
    {
      "src": "/login(.*)",
      "dest": "/public/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
